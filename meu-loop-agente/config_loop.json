{
  "agente": {
    "modelo": "deepseek-chat",
    "temperatura": 0.2
  },
  "verificacao": {
    "diretorio_de_trabalho": "workspace",
    "comandos": [
      "npm run lint",
      "npm run typecheck",
      "npm run test",
      "npm run build"
    ],
    "parar_no_primeiro_erro": true,
    "timeout_segundos": 900
  },
  "metrica": {
    "nome": "Tamanho do bundle inicial da homepage",
    "unidade": "kB",
    "direcao": "menor_melhor",
    "comando": "npm run analyze",
    "regex": "First Load JS shared by all\\s+([0-9]+(?:[.,][0-9]+)?)\\s*kB",
    "grupo": 1
  },
  "limites": {
    "max_iteracoes": 20,
    "rejeicoes_consecutivas": 5
  }
}
